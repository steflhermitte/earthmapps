@article{Lhermitte2020,
	abstract = {{\textless}p{\textgreater}Pine Island Glacier and Thwaites Glacier in the Amundsen Sea Embayment are among the fastest changing outlet glaciers in West Antarctica with large consequences for global sea level. Yet, assessing how much and how fast both glaciers will weaken if these changes continue remains a major uncertainty as many of the processes that control their ice shelf weakening and grounding line retreat are not well understood. Here, we combine multisource satellite imagery with modeling to uncover the rapid development of damage areas in the shear zones of Pine Island and Thwaites ice shelves. These damage areas consist of highly crevassed areas and open fractures and are first signs that the shear zones of both ice shelves have structurally weakened over the past decade. Idealized model results reveal moreover that the damage initiates a feedback process where initial ice shelf weakening triggers the development of damage in their shear zones, which results in further speedup, shearing, and weakening, hence promoting additional damage development. This damage feedback potentially preconditions these ice shelves for disintegration and enhances grounding line retreat. The results of this study suggest that damage feedback processes are key to future ice shelf stability, grounding line retreat, and sea level contributions from Antarctica. Moreover, they underline the need for incorporating these feedback processes, which are currently not accounted for in most ice sheet models, to improve sea level rise projections.{\textless}/p{\textgreater}},
	author = {Lhermitte, Stef and Sun, Sainan and Shuman, Christopher and Wouters, Bert and Pattyn, Frank and Wuite, Jan and Berthier, Etienne and Nagler, Thomas},
	date-added = {2020-09-18 01:01:52 +0200},
	date-modified = {2022-09-23 15:25:15 +0200},
	doi = {10.1073/pnas.1912890117},
	file = {:Users/steflhermitte/ownCloud/Mendeley/Lhermitte et al.{\_}2019{\_}Damage accelerates ice shelf instability and mass loss in Amundsen Sea Embayment.pdf:pdf},
	issn = {0027-8424},
	journal = {Proceedings of the National Academy of Sciences},
	month = {9},
	pages = {201912890},
	publisher = {National Academy of Sciences},
	title = {{Damage accelerates ice shelf instability and mass loss in Amundsen Sea Embayment}},
	url = {http://www.pnas.org/lookup/doi/10.1073/pnas.1912890117},
	year = {2020},
	bdsk-url-1 = {http://www.pnas.org/lookup/doi/10.1073/pnas.1912890117},
	bdsk-url-2 = {https://doi.org/10.1073/pnas.1912890117}}

@article{Noel2020,
	abstract = {{\textless}p{\textgreater}Compared to other Arctic ice masses, Svalbard glaciers are low-elevated with flat interior accumulation areas, resulting in a marked peak in their current hypsometry (area-elevation distribution) at  {\~{}}450 m above sea level. Since summer melt consistently exceeds winter snowfall, these low-lying glaciers can only survive by refreezing a considerable fraction of surface melt and rain in the porous firn layer covering their accumulation zones. We use a high-resolution climate model to show that modest atmospheric warming in the mid-1980s forced the firn zone to retreat upward by  {\~{}}100 m to coincide with the hypsometry peak. This led to a rapid areal reduction of firn cover available for refreezing, and strongly increased runoff from dark, bare ice areas, amplifying mass loss from all elevations. As the firn line fluctuates around the hypsometry peak in the current climate, Svalbard glaciers will continue to lose mass and show high sensitivity to temperature perturbations.{\textless}/p{\textgreater}},
	author = {No{\"{e}}l, Brice and Jakobs, C. L. and van Pelt, W. J. J. and Lhermitte, S. and Wouters, B. and Kohler, J. and Hagen, J. O. and Luks, B. and Reijmer, C. H. and van de Berg, W. J. and van den Broeke, M. R.},
	date-added = {2020-09-18 01:01:52 +0200},
	date-modified = {2022-09-23 15:25:18 +0200},
	doi = {10.1038/s41467-020-18356-1},
	file = {:Users/steflhermitte/ownCloud/Mendeley/No{\"{e}}l et al.{\_}2020{\_}Low elevation of Svalbard glaciers drives high mass loss variability.pdf:pdf},
	issn = {2041-1723},
	journal = {Nature Communications},
	month = {9},
	number = {1},
	pages = {4597},
	publisher = {Nature Publishing Group},
	title = {{Low elevation of Svalbard glaciers drives high mass loss variability}},
	url = {http://www.nature.com/articles/s41467-020-18356-1},
	volume = {11},
	year = {2020},
	bdsk-url-1 = {http://www.nature.com/articles/s41467-020-18356-1},
	bdsk-url-2 = {https://doi.org/10.1038/s41467-020-18356-1}}

